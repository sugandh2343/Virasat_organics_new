# Public configuration only. Copy to .env.local; existing storefront stays mock-backed.
VITE_API_BASE_URL=https://virasatorganics.com/api
# Optional development proxy (no PHP runs locally):
# VITE_API_BASE_URL=/api
# API_PROXY_TARGET=https://virasatorganics.com
# API_PROXY_ENABLED=true

# Explicit: mock (default) or api. No secrets in VITE variables.
VITE_DATA_MODE=mock
# Set true with API_PROXY_ENABLED=true when using the secure same-origin dev proxy.
VITE_API_PROXY_ENABLED=false
